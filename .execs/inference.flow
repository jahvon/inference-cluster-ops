# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json
visibility: public
tags: [inference, vllm, model]
description: |
  Talking to the model, and debugging it when it will not talk back.

  The endpoints here go through the SSH tunnel, which every one of them opens for
  itself if it is not already up -- there is no separate step to remember.

executables:
  - verb: open
    name: tunnel
    aliases: [forward, proxy]
    description: |
      Open the SSH tunnel in the background and return immediately.

        localhost:6443   the cluster, for kubectl
        localhost:8000   vLLM, through Envoy

      Backgrounded on purpose: it is what lets `test chat`, `list models` and
      `open dashboard` work without keeping a terminal parked on a foreground
      process. Idempotent, so running it twice is harmless.

      Only port 22 is open on the node, and only to your address -- everything
      else rides inside this one session, which is why no other port is ever
      exposed.
    exec:
      dir: //
      cmd: bash scripts/tunnel.sh ensure

  - verb: disconnect
    name: tunnel
    aliases: [close]
    description: Tear down the background tunnel. Matches only the one this workspace opened.
    exec:
      dir: //
      cmd: bash scripts/tunnel.sh close

  - verb: test
    name: chat
    aliases: [prompt, ask]
    description: |
      Send one prompt and print the reply.

      Qwen3 reasons before answering, so the thinking trace is separated from the
      answer rather than arriving inline in `<think>` tags.

      Quotes and newlines in the prompt are safe -- the body is built with
      `toJSON`, which escapes them. A literal `$` is not: flow expands `$word` in
      argument values and drops what it cannot resolve.
    serial:
      dir: //
      args:
        - pos: 1
          envKey: PROMPT
          default: Say hello in exactly five words.
      execs:
        - name: tunnel
          cmd: bash scripts/tunnel.sh ensure
        # TODO: patch flow arg passthrough bug
        - ref: send prompt
          args: ["-"]

  - verb: send
    name: prompt
    visibility: internal
    request:
      args:
        - pos: 1
          envKey: PROMPT
          default: Say hello in exactly five words.
      method: POST
      url: http://localhost:8000/v1/chat/completions
      headers:
        Content-Type: application/json
      # The body is an Expr expression. toJSON escapes both user-controlled strings, so a prompt
      # containing quotes, newlines or a $ just works.
      body: >
        '{"model":' + toJSON(env["SERVED_MODEL_NAME"]) +
        ',"messages":[{"role":"user","content":' + toJSON(env["PROMPT"]) + '}]' +
        ',"max_tokens":' + env["MAX_TOKENS"] + '}'
      params:
        # envFile paths resolve against the flow file's own directory, so this
        # reaches up out of .execs/.
        - envKey: SERVED_MODEL_NAME
          envFile: ../k8s/config.env
        - envKey: MAX_TOKENS
          text: "256"
      timeout: 5m
      validStatusCodes: [200]
      logResponse: true
      # Qwen3 reasons before answering. Splitting reasoning_content out here is
      # the whole reason this is a transform and not a raw response dump.
      transformResponse: >
        let m = fromJSON(body)["choices"][0]["message"];
        let u = fromJSON(body)["usage"];
        (m["reasoning_content"] != nil ? "[thinking] " + m["reasoning_content"] + "\n\n" : "") +
        m["content"] +
        "\n\n(" + toJSON(u["prompt_tokens"]) + " prompt + " + toJSON(u["completion_tokens"]) + " completion tokens)"

  - verb: list
    name: models
    aliases: [served]
    description: |
      Which model the server is actually serving, and the name clients should put
      in the `model` field of a request.
    serial:
      dir: //
      execs:
        - name: tunnel
          cmd: bash scripts/tunnel.sh ensure
        - ref: get models

  - verb: get
    name: models
    visibility: internal
    request:
      method: GET
      url: http://localhost:8000/v1/models
      validStatusCodes: [200]
      logResponse: true
      transformResponse: 'join(map(fromJSON(body)["data"], #["id"]), "\n")'

  - verb: check
    name: health
    aliases: [ping]
    description: |
      Quick yes/no on whether vLLM is answering through Envoy.

      A 200 means the whole path is live: tunnel, Envoy, and at least one pod
      passing its readiness probe.
    serial:
      dir: //
      execs:
        - name: tunnel
          cmd: bash scripts/tunnel.sh ensure
        - ref: get health

  - verb: get
    name: health
    visibility: internal
    request:
      method: GET
      url: http://localhost:8000/health
      timeout: 10s
      validStatusCodes: [200]
      transformResponse: '"vLLM is healthy"'

  - verb: show
    name: logs
    aliases: [vllm-logs]
    description: Tail vLLM logs across every replica. Where to look when the model will not load.
    exec:
      dir: //
      cmd: make logs

  - verb: show
    name: proxy-logs
    aliases: [envoy-logs]
    description: |
      Tail Envoy's logs.

      Distinct from the vLLM logs: routing failures, upstream connection errors
      and truncated streams show up here, not there.
    exec:
      dir: //
      cmd: make envoy-logs

  - verb: show
    name: boot-logs
    aliases: [startup]
    description: |
      The node bootstrap log: data disk mount, GPU driver wait, k3s install.

      Check here first when a fresh boot never becomes healthy -- a failed disk
      mount, or a k3s install that could not find the nvidia runtime, shows up
      here and not in the vLLM logs.
    exec:
      dir: //
      cmd: make boot-logs

  - verb: watch
    name: gpu
    aliases: [nvidia-smi, vram]
    description: |
      GPU utilization and VRAM.

      The number to watch is memory used: vLLM preallocates its KV cache at load,
      so near-full at idle is expected, not a leak. With N replicas you should see
      N processes, and their total must stay under 24GB -- time-slicing will not
      enforce that for you.
    exec:
      dir: //
      cmd: make gpu

  - verb: connect
    name: node
    aliases: [ssh, shell]
    description: SSH to the node. kubectl is on PATH there and already pointed at the local cluster.
    exec:
      dir: //
      cmd: make ssh

  - verb: show
    name: slo
    aliases: [sli, latency]
    tags: [observability, slo]
    description: |
      Latency percentiles, SLO violations and recovery times over a window.

      The objectives it measures against live in `k8s/config.env` and are the same
      ones the canary gate uses. Window defaults to the last hour; override with
      SLO_RANGE=6h.

      Needs traffic to be meaningful -- an idle cluster reads as 100% available
      because there is nothing to fail. Run `benchmark baseline` first.
    serial:
      dir: //
      execs:
        - name: gather
          cmd: make slo > .slo.json
        - ref: generate slo

  - verb: generate
    name: slo
    visibility: internal
    render:
      dir: //
      templateFile: docs/slo.md
      templateDataFile: .slo.json

  - verb: benchmark
    name: baseline
    aliases: [bench, calibrate]
    tags: [observability, slo, benchmark, load]
    description: |
      Drive load through Envoy and report throughput, latency percentiles and goodput.

      Runs kubernetes-sigs/inference-perf as a Job inside the cluster -- the same
      harness `start load` uses for sustained traffic, so the calibration number and
      the number you watch under load mean the same thing.

      Refuses to run while the sustained generators are up: that would measure
      contention and quietly become the number your SLO thresholds are set from.

      This is what produces the per-user token rate exactly, and the baseline the
      thresholds in `k8s/config.env` should be set from.

      Shape the run with BENCH_* in `k8s/config.env`. Raise BENCH_CONCURRENCY until
      tokens/s stops climbing while TTFT keeps rising -- that is the knee.
    serial:
      dir: //
      execs:
        - name: run
          cmd: make calibrate > .bench.json
        - ref: generate baseline

  # Internal: the presentation half of `benchmark baseline`.
  - verb: generate
    name: baseline
    visibility: internal
    render:
      dir: //
      templateFile: docs/bench.md
      templateDataFile: .bench.json

  - verb: start
    name: load
    aliases: [load, traffic]
    tags: [observability, load, tenant]
    description: |
      Hold the cluster under sustained multi-tenant traffic.

      Runs kubernetes-sigs/inference-perf as two tenants at once, shaped to
      contend: `batch` sends the longer prompts whose prefills occupy the
      GPU, and `interactive` sends short ones and is the tenant you watch suffer
      for it. That contention is the reason the per-tenant dimension exists.

      Unlike `benchmark baseline` this produces no report -- it produces traffic.
      The measurement is in Grafana and `show slo`. Leave it running while you
      promote a canary, abort one, or preempt the node, and the SLO timeline shows
      what it cost.

      Shape it with LOAD_* in `k8s/config.env`. It keeps running until `stop load`.
    exec:
      dir: //
      cmd: make load-start

  - verb: stop
    name: load
    aliases: [unload]
    tags: [observability, load, tenant]
    description: |
      Stop the sustained load generators.

      Leaves their config in the cluster, so starting again is immediate.
    exec:
      dir: //
      cmd: make load-stop

  - verb: show
    name: load
    aliases: [traffic-status]
    tags: [observability, load, tenant]
    description: Whether the load generators are running, and how many replicas each tenant has.
    exec:
      logMode: text
      dir: //
      cmd: make load-status
