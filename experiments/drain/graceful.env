# The same drain with a graceful shutdown.
#
# Run against drain/stock to measure whether the fix works.
#
# SETTING THESE HERE DOES NOT TEST THEM. A rollout drains the PREVIOUS revision's
# pods, so this overlay only changes the pods being CREATED -- the ones being
# destroyed still carry the old teardown config.
#
# To actually test this: put the values in config.env, run `flow deploy workloads`
# (that rollout still truncates under the old rules -- ignore it), confirm the live
# pods carry them and then run the scenario.
. experiments/drain/stock.env

# 1024-token outputs at ~0.047s TPOT are ~48s streams, so 60s covers the longest one
# in flight. Grace has to clear it (it includes preStop).
PRESTOP_SLEEP_SECONDS=${PRESTOP_SLEEP_SECONDS:-60}
TERMINATION_GRACE_SECONDS=${TERMINATION_GRACE_SECONDS:-90}
