# Drain with long generations.
#
# No revision change: the nonce alone rolls the fleet. What is varied is the traffic
# mix, weighted toward long outputs so there are always multi-second SSE streams in
# flight when a pod goes away.
#
# There is no preStop hook and no terminationGracePeriodSeconds on the Rollout, so
# pods get the Kubernetes default 30s.
LOAD_BATCH_OUTPUT=1024
