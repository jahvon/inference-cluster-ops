# A bad revision that does not crash.
#
# --max-num-seqs=1 collapses batching: vLLM serves one sequence at a time, so under
# load requests queue instead of running concurrently. Nothing fails, no pod restarts,
# no probe goes red. TTFT degrades badly and everything still reports Healthy.
#
# Run this against experiments/bad-revision/ungated.env for the comparison.
EXTRA_VLLM_ARGS="--reasoning-parser qwen3 --max-num-seqs=1"
