# Workload configuration.

# --- model ------------------------------------------------------------------
# Qwen3-0.6B: dense, standard GQA (16 Q / 8 KV heads, 28 layers), text-only, 32k
# native context. Deliberately tiny -- ~1.2GB of bf16 weights on a 24GB L4, which
# is what leaves room for two pods to share the GPU.
MODEL_ID=Qwen/Qwen3-0.6B
SERVED_MODEL_NAME=Qwen3-0.6B
VLLM_IMAGE=vllm/vllm-openai:v0.26.0

# KV cache, not weights, is what competes for VRAM: ~112 KiB/token means one full
# 32k sequence costs ~3.5GiB, roughly 3x the model itself.
MAX_MODEL_LEN=32768

# Separates thinking from the answer into reasoning_content, which `flow test chat`
# renders separately.
EXTRA_VLLM_ARGS="--reasoning-parser qwen3"

# --- GPU sharing ------------------------------------------------------------
# The L4 has no MIG, so time-slicing is the only way to share it -- and time
# slices give NO memory isolation. Nothing stops co-resident pods from taking
# each other's VRAM, so each pod's share has to be stated explicitly.
#
# It is stated as an ABSOLUTE KV cache size, not as a fraction. vLLM's
# --gpu-memory-utilization is a fraction of TOTAL device memory from which it
# subtracts DEVICE-WIDE usage -- including every co-resident pod. So pod 2 always
# subtracts pod 1's full claim from its own identical budget:
#
#   pod 2 available = util x TOTAL - (pod 1 footprint + own overhead)
#                   = util x TOTAL - (util x TOTAL + overhead)
#                   = -overhead                    <- negative for ANY util
#
# That is why "divide the budget by N" cannot work for N > 1 at any value; it
# fails with "No available memory for the cache blocks".
# --kv-cache-memory-bytes short-circuits that calculation entirely -- vLLM
# returns it before profiling -- giving each pod a fixed, co-residency-safe
# allocation.
#
# Budget on a 24GB L4:  2 pods x (~2 GiB fixed + 5 GiB KV) = 14 GiB, leaving
# ~8 GiB headroom. The ~2 GiB fixed cost is weights + CUDA context +
# torch.compile workspace.
#
# 5 GiB is ~47k tokens of KV at ~112 KiB/token, comfortably more than
# MAX_MODEL_LEN, so a single full-context request still fits.
KV_CACHE_GIB=5

# Still passed to vLLM as a ceiling, but it no longer sizes the KV cache.
GPU_MEM_BUDGET=0.90
GPU_TIMESLICE_REPLICAS=4

# 2 workers is the minimum that demonstrates anything useful for experiments
VLLM_REPLICAS=2

# --- serving ----------------------------------------------------------------
ENVOY_IMAGE=envoyproxy/envoy:v1.31.5
ENVOY_NODEPORT=30800

# --- storage ----------------------------------------------------------------
# The one host-specific value in k8s/. In the homelab, swap the Rollout's
# hostPath volume for a PVC
HF_CACHE_HOSTPATH=/opt/data/huggingface

# --- monitoring -------------------------------------------------------------
# p95 time-to-first-token, in seconds, above which a canary rolls back.
# MEASURE A REAL BASELINE BEFORE TRUSTING THIS. An arbitrary number either never
# fires or blocks every rollout.
TTFT_P95_THRESHOLD=2.0
