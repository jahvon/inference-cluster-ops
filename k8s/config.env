# Workload configuration.

# --- model ------------------------------------------------------------------
# Qwen3-0.6B: dense, standard GQA (16 Q / 8 KV heads, 28 layers), text-only, 32k
# native context. Deliberately tiny -- ~1.2GB of bf16 weights on a 24GB L4, which
# is what leaves room for two pods to share the GPU.
MODEL_ID=Qwen/Qwen3-0.6B
SERVED_MODEL_NAME=Qwen3-0.6B
VLLM_IMAGE=vllm/vllm-openai:v0.26.0

# KV cache, not weights, is what competes for VRAM: ~112 KiB/token means one full
# 32k sequence costs ~3.5GiB, roughly 3x the model itself.
MAX_MODEL_LEN=32768

# Separates thinking from the answer into reasoning_content, which `flow test chat`
# renders separately.
EXTRA_VLLM_ARGS="--reasoning-parser qwen3"

# --- GPU sharing ------------------------------------------------------------
# The L4 has no MIG, so time-slicing is the only way to share it -- and time
# slices give NO memory isolation. Nothing stops co-resident pods from taking
# each other's VRAM, so each pod's share has to be stated explicitly.
#
# It is stated as an ABSOLUTE KV cache size, not as a fraction. vLLM's
# --gpu-memory-utilization is a fraction of TOTAL device memory from which it
# subtracts DEVICE-WIDE usage -- including every co-resident pod. So pod 2 always
# subtracts pod 1's full claim from its own identical budget:
#
#   pod 2 available = util x TOTAL - (pod 1 footprint + own overhead)
#                   = util x TOTAL - (util x TOTAL + overhead)
#                   = -overhead                    <- negative for ANY util
#
# That is why "divide the budget by N" cannot work for N > 1 at any value; it
# fails with "No available memory for the cache blocks".
# --kv-cache-memory-bytes short-circuits that calculation entirely -- vLLM
# returns it before profiling -- giving each pod a fixed, co-residency-safe
# allocation.
#
# Budget, MEASURED on the L4 rather than estimated (DCGM_FI_DEV_FB_*, 2 pods up):
# 23034 MiB total   15873 MiB used   6689 MiB free
#
# So the fixed cost is ~2.75 GiB per pod.
#
# 5 GiB is ~47k tokens of KV at ~112 KiB/token, comfortably more than
# MAX_MODEL_LEN, so a single full-context request still fits.
KV_CACHE_GIB=5

# Still passed to vLLM as a ceiling, but it no longer sizes the KV cache.
GPU_MEM_BUDGET=0.90
GPU_TIMESLICE_REPLICAS=4

# 2 workers is the minimum that demonstrates anything useful for experiments
VLLM_REPLICAS=2

# --- serving ----------------------------------------------------------------
ENVOY_IMAGE=envoyproxy/envoy:v1.31.5
ENVOY_NODEPORT=30800

# --- storage ----------------------------------------------------------------
# The one host-specific value in k8s/. In the homelab, swap the Rollout's
# hostPath volume for a PVC
HF_CACHE_HOSTPATH=/opt/data/huggingface

# --- monitoring -------------------------------------------------------------
# The service level objectives. These three are the definition of "healthy": the
# `sli:vllm:healthy` recording rule is their product, the canary gates on them, and
# `flow show slo` measures violations and recovery against them. Changing a number
# here changes all three at once.

# Measured baseline, Qwen3-0.6B on one L4, 2 replicas, concurrency 16, 512 in /
# 128 out, via `flow benchmark baseline` (inference-perf, /v1/completions),
# 2026-08-30:
#
#   TTFT   p50 0.081s  p90 0.155s  p95 0.187s  p99 0.267s
#   TPOT   p50 0.019s  p90 0.021s  p95 0.021s  p99 0.021s
#   ITL    p50 0.019s  p90 0.021s  p95 0.025s  p99 0.038s
#   e2e    p50 2.53s   p95 2.77s
#   786 output tok/s, ~49 tok/s per stream, 6.14 req/s, 0 errors
#   Both objectives met through p99.

# p95 time-to-first-token, in seconds.
#
# Set from the measured operating point, not from a round number. At the sustained
# load below, steady state is TTFT p95 0.222s with sd 0.004 over a 1m window --
# natural fluctuation is +-5%. 0.35 is ~1.6x that mean and ~30 standard deviations
# above it: no realistic chance of noise tripping it, and it triggers on a 55%
# degradation rather than requiring latency to double.
#
# The gate reads role="canary", which is one pod's share of traffic and therefore
# noisier than the fleet number this was derived from. GATE_FAILURE_LIMIT is the
# dial for that; the good-revision study is what measures it.
TTFT_P95_THRESHOLD=0.35

# p95 time-per-output-token, in seconds. Same derivation: steady state 0.047s with
# sd 0.0004, so 0.075 is ~1.6x the mean.
TPOT_P95_THRESHOLD=0.075

# Fraction of 5xx responses, measured at Envoy, above which the cluster is in
# violation. 0.01 = 1%. Envoy retries connect failures and resets before counting
# one, so this is post-retry -- what the client actually saw.
ERROR_RATIO_SLO=0.01

# Fraction of requests cut off mid-stream. Envoy cannot retry once response headers
# have gone downstream, so these reach the client as a 200 with a short body: not a
# 5xx, not a vLLM error, invisible to both objectives above. Scenario B produces
# them and nothing else does.
TRUNCATION_RATIO_SLO=0.005

# Rate window for the :rollout SLI variants. The :rate5m family answers "is the
# service healthy" and smooths accordingly; a rollout is a ~500s event whose
# interesting windows are tens of seconds, and a 5m window buries those.
#
# Do not shorten this without raising the load. At the p95 level a window needs a
# few hundred requests to be stable -- at 6 req/s, 1m is ~360.
ROLLOUT_WINDOW=1m

# --- calibration ------------------------------------------------------------
# Inputs to `flow benchmark baseline`, which runs kubernetes-sigs/inference-perf as
# a Job inside the cluster -- the same harness `flow start load` uses for sustained
# traffic, so the two share a definition of TTFT and their numbers are comparable.
#
# Defaults are a short, honest smoke test rather than a saturation run: enough
# traffic to populate every dashboard panel and produce a p95 worth trusting,
# without leaving the GPU pinned.
#
# To find the knee, raise BENCH_CONCURRENCY until TTFT p95 climbs while
# tokens/s stops climbing -- that is the point where queueing has started.
# A closed loop: hold BENCH_CONCURRENCY requests in flight until BENCH_NUM_PROMPTS
# have been sent. There is no arrival rate here on purpose -- an open loop queues
# without bound past capacity and ends up measuring the queue instead of the server.
BENCH_CONCURRENCY=16
BENCH_NUM_PROMPTS=200
BENCH_INPUT_LEN=512
BENCH_OUTPUT_LEN=128

# --- sustained load ---------------------------------------------------------
# Inputs to `flow start load`, which runs kubernetes-sigs/inference-perf as two
# concurrent tenants against Envoy.
#
# The two personas are shaped to CONTEND. `batch` submits long prompts that occupy
# the GPU in prefill; `interactive` submits short ones.
INFERENCE_PERF_IMAGE=quay.io/inference-perf/inference-perf@sha256:ac7f751fa6e36f6de4419700af127f774773d5cc606322ed550f28c55e7a9aa2

# Seconds per run. inference-perf executes its stages and exits, and the
# Deployment restarts it, so this is really "how long between restarts" -- long
# enough that the seam does not show up as a dip in the graphs.
LOAD_DURATION=3600

# Set to put the fleet near the point the SLO was calibrated at (6.14 req/s, TTFT
# p95 0.187s -- see the baseline block above), which is ~37% of the TTFT objective.
#
# At the previous 1+1 these ran at ~2 req/s and TTFT p95 sat at 12% of objective,
# with requests_waiting flat at 0 and KV cache under 7%. Nothing queued, so no
# scenario could degrade the fleet enough to breach an objective and every
# experiment came back green regardless of what it did.
#
# Measured sweep, 2026-08-31, interactive held at 3:
#
#   batch      req/s   TTFT p95   TPOT p95   output tok/s   KV
#   3 x 512     6.18     0.080      0.024        ~1000      15%
#   6 x 512     6.27     0.091      0.024         1011      13%
#   6 x 1024    5.58     0.222      0.047          827      26%   <- knee
#   9 x 1024    5.09     0.222      0.047          818      23%
#
# The knee is between 6x512 and 6x1024: TTFT climbs 2.4x while output tokens/s
# FALLS. 9x1024 confirms saturation -- 50% more offered load delivered less.
#
# 6 x 1024 is the operating point: 44% of the TTFT objective and 47% of TPOT,
# healthy, with real room to degrade. Prefill is the lever, not rate -- tripling
# the rate at 512 input moved TTFT by 14%, doubling the input more than doubled it.

# Short prompts, low rate. The victim tenant -- this is the one whose TTFT you
# watch degrade when the neighbour gets greedy.
LOAD_INTERACTIVE_RATE=3
LOAD_INTERACTIVE_INPUT=128
LOAD_INTERACTIVE_OUTPUT=64

# Longer prompts and outputs at the same rate. The noisy neighbour: prefill is
# where a time-sliced L4 actually gets taken away from someone else.
LOAD_BATCH_RATE=6
LOAD_BATCH_INPUT=1024
LOAD_BATCH_OUTPUT=256

# --- experiments -------------------------------------------------------------
# Inputs to `flow run experiment`, which rolls the fleet under load and measures
# what the rollout did. See docs/experiments.md and scripts/experiment/run.sh.

# Where vLLM looks for weights. Normally the hostPath mount itself, so a pod starts
# warm. Experiments can overrides this to an empty subdir UNDER the same mount --
# /root/.cache/huggingface/cold-<RUN_ID> -- which downloads fresh while leaving the
# warm cache the stable pods use untouched.
#
# It must stay inside the mount. A path outside it writes to the container's
# ephemeral layer, which is not on the data disk and which cleanup cannot reach.
HF_HOME_PATH=/root/.cache/huggingface

# Stamped into the pod template so an otherwise-identical rollout still changes the
# pod-template hash. Without it Argo correctly does nothing.
EXPERIMENT_NONCE=baseline

# --- canary analysis tuning ------------------------------------------------------
# The gate's shape, as opposed to its thresholds. Thresholds come from the SLO
# block above; the quantile and window come from the :rollout recording rules the
# gate now queries, so there is no gate-only copy of either to drift.
#
# The analysis clock starts when the canary pod goes READY, not when the rollout
# starts -- Argo only advances past setWeight once the canary is available. So a
# slow pod start is not measured by the gate at all, it just delays it.
#
# INITIAL_DELAY is one ROLLOUT_WINDOW, so the first sample covers a full window
# rather than a partly-filled one. Gate duration is INITIAL_DELAY + (COUNT-1) *
# INTERVAL = 150s.
GATE_INITIAL_DELAY=1m
GATE_INTERVAL=30s
GATE_COUNT=4

# How many samples may breach before the gate fails: it fails when failures EXCEED
# this, so 2 means three bad samples out of GATE_COUNT.
#
# This is the false-positive/false-negative dial and the value here is not yet
# earned -- set it from the good-revision study, which counts how often a rollout
# with nothing wrong trips the gate anyway.
GATE_FAILURE_LIMIT=2
